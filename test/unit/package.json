{
  "name": "sfia-unit-tests",
  "version": "1.0.0",
  "description": "Unit tests for SFIA Position Description Generator",
  "scripts": {
    "test:unit": "jest",
    "test:unit:watch": "jest --watch",
    "test:unit:coverage": "jest --coverage",
    "test:unit:verbose": "jest --verbose"
  },
  "dependencies": {},
  "devDependencies": {
    "jest": "^29.7.0",
    "@jest/globals": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testMatch": [
      "**/test/unit/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/constants.js",
      "!src/init.js",
      "!src/browserUpdate.js"
    ],
    "coverageDirectory": "coverage/unit",
    "coverageReporters": ["text", "lcov", "html"],
    "setupFilesAfterEnv": ["<rootDir>/test/unit/setup.js"],
    "moduleFileExtensions": ["js"],
    "transform": {}
  }
}
