{
    "name": "sfia",
    "version": "1.0.0",
    "description": "Welcome to the SFIA POSITION DESCRIPTION Tool, an innovative generator inspired by the SFIA Framework. This tool simplifies the PD creation process, allowing you to select specific skills and proficiency levels effortlessly through user-friendly check-boxes. Explore the tool [online](https://xanpho.x10.bz/index.html#/) to experience its capabilities.",
    "main": "functions-min.js",
    "directories": {
        "test": "test"
    },
    "scripts": {
        "dev": "vite",
        "build:dev": "vite build --mode development",
        "build:prd": "vite build --mode production",
        "preview": "vite preview",
        "codeceptjs": "codeceptjs run --steps",
        "codeceptjs:headless": "HEADLESS=true codeceptjs run --steps",
        "codeceptjs:ui": "codecept-ui --app",
        "test:export": "npx codeceptjs run ./test/ui/check_export_csv.local.test.js --steps --verbose",
        "test:local": "npm run kill:5502 && npm-run-all --parallel --race dev:local test:local:run",
        "test:local:run": "wait-on http://127.0.0.1:5502 && codeceptjs run --config codecept.local.conf.js --steps",
        "test:dev": "npm run kill:5503 && npm-run-all --parallel --race dev:dev test:dev:run",
        "test:dev:run": "wait-on http://127.0.0.1:5503 && codeceptjs run --config codecept.dev.conf.js --steps",
        "dev:local": "cross-env VITE_PORT=5502 vite",
        "dev:dev": "cross-env VITE_PORT=5503 vite",
        "kill:5502": "cross-env-shell \"npx kill-port 5502 || echo 'Port 5502 was not in use'\"",
        "kill:5503": "cross-env-shell \"npx kill-port 5503 || echo 'Port 5503 was not in use'\"",
        "start-server:dev": "npm run dev:dev",
        "start-server:local": "npm run dev:local",
        "stop-server:dev": "npm run kill:5503",
        "stop-server:local": "npm run kill:5502",
        "test:unit": "jest",
        "test:unit:watch": "jest --watch",
        "test:unit:coverage": "jest --coverage",
        "test:unit:verbose": "jest --verbose"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "devDependencies": {
        "@babel/core": "^7.27.4",
        "@babel/preset-env": "^7.27.2",
        "@codeceptjs/configure": "^1.0.2",
        "@codeceptjs/helper": "^2.0.4",
        "@jest/globals": "^29.7.0",
        "@linthtml/linthtml": "^0.9.6",
        "babel-jest": "^29.7.0",
        "codeceptjs": "^3.7.2",
        "cross-env": "^7.0.3",
        "css-loader": "^7.1.2",
        "dotenv": "^16.4.7",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0",
        "kill-port": "^2.0.1",
        "npm-run-all": "^4.1.5",
        "playwright": "^1.50.1",
        "style-loader": "^4.0.0",
        "vite": "^6.3.5",
        "wait-on": "^8.0.3"
    },
    "dependencies": {
        "csv-parser": "^3.0.0",
        "fs": "^0.0.1-security",
        "sfia": "file:"
    },
    "jest": {
        "testEnvironment": "jsdom",
        "testMatch": [
            "**/test/unit/**/*.test.js"
        ],
        "collectCoverageFrom": [
            "src/**/*.js",
            "src/**/*.mjs",
            "!src/constants.js",
            "!src/init.js",
            "!src/browserUpdate.js",
            "!src/vendor/**",
            "!src/modules/**/*.min.js"
        ],
        "coverageDirectory": "coverage/unit",
        "coverageReporters": [
            "text",
            "lcov",
            "html"
        ],
        "setupFilesAfterEnv": [
            "<rootDir>/test/unit/setup.js"
        ],
        "moduleFileExtensions": [
            "js",
            "mjs"
        ],
        "transform": {
            "^.+\\.mjs$": "babel-jest"
        },
        "globals": {
            "__DEV__": true
        },
        "testEnvironmentOptions": {
            "customExportConditions": [
                "node",
                "node-addons"
            ]
        }
    }
}
